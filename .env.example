# ========================================================
# SPGMS - Environment Configuration
# ========================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://vlyfifpdsmimphchitnm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_co9uWjRY8D5PSec1rezazA_O2P2PyHs

# Supabase PostgreSQL Database Connection String
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Direct connection (port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vlyfifpdsmimphchitnm.supabase.co:5432/postgres
# Or Transaction Pooler (port 6543, recommended for hosted deployments):
# DATABASE_URL=postgresql://postgres.vlyfifpdsmimphchitnm:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# If left blank, the app will run with a persistent/in-memory local embedded database.
DATABASE_URL=

# JWT Secret for session authentication (replace with any random string)
JWT_SECRET=spgms-secure-jwt-production-secret-key-2026

# Backend Server Port and Frontend Client URL
PORT=4000
FRONTEND_URL=http://localhost:5173

# Optional: a 32-byte base64 key for encrypting workspace Notion tokens
TOKEN_ENCRYPTION_KEY=
